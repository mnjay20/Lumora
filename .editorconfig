# Top-level EditorConfig configuration

root = true

# Default settings for all files

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python files

[*.py]
indent_style = space
indent_size = 4

# JSON, YAML and Markdown

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

# JavaScript and TypeScript

[*.{js,ts,jsx,tsx}]
indent_style = space
indent_size = 2

# Godot GDScript

[*.gd]
indent_style = tab
indent_size = 4

# Godot scene and resource files

[*.{tscn,tres}]
indent_style = tab
indent_size = 4

# Shell scripts

[*.sh]
indent_style = space
indent_size = 2

# Makefiles require tabs

[Makefile]
indent_style = tab
